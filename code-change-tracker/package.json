{
  "name": "obsidian-code-change-tracker",
  "version": "1.0.0",
  "description": "Track changes in your code files and generate documentation based on code modifications.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "code-documentation",
    "code-change-tracking"
  ],
  "author": "GreyHatDoc",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "^5.2.0",
    "@typescript-eslint/parser": "^5.2.0",
    "builtin-modules": "^3.2.0",
    "esbuild": "^0.25.11",
    "obsidian": "^1.10.3",
    "tslib": "2.3.1",
    "typescript": "^4.9.5"
  }
}